# Copy to .env. Values below are local placeholders, not production secrets.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DATABASE_URL=postgres://recruit:recruit@127.0.0.1:5432/recruit
REDIS_URL=redis://127.0.0.1:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1,be

# deterministic is allowed only when DJANGO_DEBUG=true or SABLE_TESTING=1.
# Production must set AI_PROVIDER=hosted and a real AI_API_KEY or the process refuses to start.
AI_PROVIDER=deterministic
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=3
AI_RATE_LIMIT_PER_MINUTE=30
AI_MAX_CONCURRENCY=4

# Resume storage: local writes under be/var/media. Use "minio" for self-hosted
# S3-compatible storage, or "s3" for AWS (then leave S3_ENDPOINT_URL empty).
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=
S3_ENDPOINT_URL=http://127.0.0.1:9000
# Address used to sign download links, as seen by the browser. Defaults to S3_ENDPOINT_URL.
# In Docker the API uses http://minio:9000 but the browser needs http://127.0.0.1:9000.
S3_PUBLIC_ENDPOINT_URL=
S3_BUCKET=sable-resumes
S3_ACCESS_KEY_ID=sable
S3_SECRET_ACCESS_KEY=sable-minio-dev
S3_REGION=us-east-1
# MinIO needs path-style addressing; the bucket is created on first use.
S3_ADDRESSING_STYLE=path
S3_CREATE_BUCKET=true
DOWNLOAD_URL_TTL_SECONDS=120

OCR_ENABLED=false
ALLOW_UNSCANNED_UPLOADS=true
CLAMAV_HOST=
MAX_UPLOAD_BYTES=15728640

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
DEFAULT_FROM_EMAIL=sable@localhost
PASSWORD_RESET_URL=http://127.0.0.1:43123/reset-password
CORS_ALLOWED_ORIGINS=http://127.0.0.1:43123,http://localhost:43123
